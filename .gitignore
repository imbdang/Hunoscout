# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Dữ liệu sinh ra khi chạy ---
# Commit pattern dùng chung (data/huno_pattern/) + map đã học của từng điện thoại, từng nhà
# (data/<serial>/<home_id>/huno_pattern/: toạ độ, title, cạnh core/feature/root_type — chỉ dùng lại khi đúng máy,
# xem "resolved_for"). Mọi thứ khác trong data/<serial>/ (profile.json, home.json sinh lại khi chạy…) vẫn bỏ qua.
data/*
!data/*/
data/*/*
!data/*/*/
data/*/*/*
!data/*/*/huno_pattern/
!data/huno_pattern/
!data/huno_pattern/**

# Ảnh chụp, báo cáo test
runs/

# Dump cây UI: có thể chứa dữ liệu nhạy cảm (đã gặp ô mật khẩu hiện chữ thường)
*.xml
*.uix

# --- Bí mật / cấu hình cục bộ ---
.env
.env.*
.claude/settings.local.json

# --- Editor / hệ điều hành ---
.vscode/
.idea/
*.swp
*~
.DS_Store
